# Copy to .env and fill in. .env is gitignored.
#
# Everything below is optional. With no keys set, FinePrint runs on offline
# providers (keyword clause classification, lexical hashed embeddings) so
# ingestion, retrieval, and the eval suite still work end to end.

# --- LLM: classification, synthesis, grounding gate, amendment detection -----
# Set one. Provider is auto-selected from whichever key is present, in this
# order; set LLM_PROVIDER to override.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# LLM_PROVIDER=anthropic        # anthropic | openai | gemini | offline
# CHEAP_MODEL=                  # pin a model instead of the provider default
# SMART_MODEL=

# --- Embeddings (Anthropic has no embeddings endpoint, hence a separate key) --
# Auto-selected in order: voyage, openai, gemini.
VOYAGE_API_KEY=pa-...

# EMBEDDING_PROVIDER=voyage     # voyage | openai | gemini | offline
# EMBEDDING_MODEL=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fineprint:fineprint@localhost:5433/fineprint

# --- Retrieval --------------------------------------------------------------
# TOP_K=8
# MIN_SIMILARITY=0.35

# --- Hosting (see deploy/README.md) -----------------------------------------
# Gate the whole app behind HTTP Basic. REQUIRED before exposing a public URL:
# leases are private legal documents and there are no user accounts.
# APP_PASSWORD=
# APP_USERNAME=tenant

# MAX_UPLOAD_MB=25
# CORS_ORIGINS=https://your-frontend.example.com
